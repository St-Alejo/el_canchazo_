DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Local (Docker): postgres://canchazo:canchazo@localhost:55432/canchazo
# (puerto 55432, no 5432, porque este equipo ya tiene un Postgres nativo ahi)
# Supabase: cadena de conexion del proyecto (ver docs/arquitectura-tecnica.md)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Adaptador de pagos: reservas.adapters.wompi.AdaptadorWompi en producción,
# reservas.adapters.fake.AdaptadorPagosFalso para desarrollo local sin llaves reales.
ADAPTADOR_PAGOS=reservas.adapters.wompi.AdaptadorWompi
WOMPI_LLAVE_PUBLICA=pub_test_xxx
WOMPI_SECRETO_INTEGRIDAD=xxx
WOMPI_SECRETO_EVENTOS=xxx
# WOMPI_URL_CHECKOUT=https://checkout.wompi.co/p/

# Origen del frontend de Next.js en desarrollo (CORS + URL del checkout simulado
# del adaptador de pagos falso).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
